# Copy to .env (or ~/.config/mailcow-dav-mcp/.env) and chmod 600. Never commit the real file.
MAILCOW_DAV_URL=https://mail.example.com
MAILCOW_DAV_USER=you@example.com
# mailcow app password: Mailbox → Edit → App passwords → "Allow for": DAV/SOGo
MAILCOW_DAV_PASSWORD=
# Optional
MAILCOW_DAV_TIMEZONE=Europe/Rome
MAILCOW_DAV_VERIFY_SSL=1
MAILCOW_DAV_TIMEOUT=30
# MAILCOW_DAV_PRINCIPAL_PATH=/SOGo/dav/you@example.com/
# MAILCOW_DAV_EXPORT_DIR=~/mailcow-dav-exports
# HTTP mode (ChatGPT / remote clients)
# MAILCOW_DAV_MCP_TOKEN=
# MAILCOW_DAV_MCP_ALLOWED_HOSTS=mcp.example.com
